{
    "name": "@jesselei1102-hue/revit-mcp-server-apps",
    "version": "1.0.0",
    "description": "MCP server + MCP Apps for Autodesk Revit (fork of mcp-server-for-revit with schedule UI)",
    "main": "index.js",
    "type": "module",
    "bin": {
        "mcp-server-for-revit": "./build/index.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "clean": "rimraf build",
        "build:app": "vite build",
        "build": "npm run clean && tsc && npm run build:app",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "theme:sync": "node scripts/theme-sync.mjs",
        "theme:check": "node scripts/theme-sync.mjs --check"
    },
    "files": [
        "build",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jesselei1102-hue/Revit-MCP-Server-Apps.git"
    },
    "keywords": [
        "mcp",
        "mcp-apps",
        "revit",
        "autodesk",
        "claude",
        "cursor",
        "ai",
        "bim",
        "architecture"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/jesselei1102-hue/Revit-MCP-Server-Apps/issues"
    },
    "homepage": "https://github.com/jesselei1102-hue/Revit-MCP-Server-Apps#readme",
    "dependencies": {
        "@modelcontextprotocol/ext-apps": "^1.1.2",
        "@modelcontextprotocol/sdk": "^1.7.0",
        "better-sqlite3": "^12.8.0",
        "fast-xml-parser": "^4.5.7",
        "ws": "^8.18.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.13.10",
        "@types/ws": "^8.18.0",
        "rimraf": "^5.0.10",
        "typescript": "^5.8.2",
        "vite": "^7.1.5",
        "vite-plugin-singlefile": "^2.3.0",
        "vitest": "^3.2.7"
    }
}
